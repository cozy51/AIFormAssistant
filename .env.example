# Google Cloud: Webアプリケーション用OAuth 2.0クライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google AI Studioから取得。NEXT_PUBLIC_を付けない
GEMINI_API_KEY=
# 使用可能な安定版は設定画面のモデル一覧から確認してください
GEMINI_MODEL=gemini-2.5-flash
# 公開URLと正確に一致させる。本番はHTTPS必須
APP_URL=http://localhost:3000
# アプリを利用できる確認済みGoogleメールアドレス（カンマ区切り）
APP_ALLOWED_EMAILS=
# 32文字以上のランダム文字列。ローカルで暗号化に使う実値が必要
SESSION_SECRET=
# アプリのデータとAI使用量を保存するGoogle DriveフォルダのID（またはフォルダURL）
DRIVE_FOLDER_ID=
# 1か月（日本時間）のGeminiトークン使用量の上限。未設定・空欄は5000000、0は無制限
GEMINI_MONTHLY_TOKEN_LIMIT=5000000
